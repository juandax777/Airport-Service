# Copia este archivo como .env. No publiques el archivo .env real.

# Docker Compose
COMPOSE_PROJECT_NAME=personal-itineraries
WEB_APP_PORT=8000
AIRPORT_SERVICE_PORT=8001
ITINERARY_SERVICE_PORT=8002
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API externa
API_COLOMBIA_BASE_URL=https://api-colombia.com/api/v1
REQUEST_TIMEOUT_SECONDS=5

# URLs usadas al ejecutar las aplicaciones directamente con Python
AIRPORT_SERVICE_URL=http://127.0.0.1:8001
ITINERARY_SERVICE_URL=http://127.0.0.1:8002

# PostgreSQL local de Docker Compose
ITINERARY_DB_NAME=itineraries
ITINERARY_DB_USER=itinerary
ITINERARY_DB_PASSWORD=change-me-itinerary
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=change-me-notification

# RabbitMQ local de Docker Compose
RABBITMQ_USER=itineraries
RABBITMQ_PASSWORD=change-me-rabbitmq
